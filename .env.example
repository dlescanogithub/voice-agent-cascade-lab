# Copy to .env locally if you want a reminder. This process does NOT load .env.
# Export variables in the shell. Leave real-provider flags at 0.

VOICE_CASCADE_SEED=42
VOICE_CASCADE_HMAC_SECRET=
VOICE_CASCADE_MAX_ATTEMPTS=3
VOICE_CASCADE_BACKOFF_BASE_MS=40
VOICE_CASCADE_BACKOFF_CAP_MS=500
VOICE_CASCADE_JITTER_MS=20
VOICE_CASCADE_TIMEOUT_MS=300
VOICE_CASCADE_LOG_LEVEL=INFO
VOICE_CASCADE_DATA_DIR=./var

# Real adapters are stubs. They never call a vendor. Leave these at 0.
VOICE_CASCADE_ENABLE_REAL_STT=0
VOICE_CASCADE_ENABLE_REAL_LLM=0
VOICE_CASCADE_ENABLE_REAL_TTS=0
VOICE_CASCADE_STT_API_KEY=
VOICE_CASCADE_LLM_API_KEY=
VOICE_CASCADE_TTS_API_KEY=
