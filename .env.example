# Copy to .env locally if you want a reminder. This process does NOT load .env.
# Export variables in the shell. Leave real-provider flags at 0.

VOICE_CASCADE_SEED=42
VOICE_CASCADE_HMAC_SECRET=
VOICE_CASCADE_MAX_ATTEMPTS=3
VOICE_CASCADE_BACKOFF_BASE_MS=40
VOICE_CASCADE_BACKOFF_CAP_MS=500
VOICE_CASCADE_JITTER_MS=20
VOICE_CASCADE_TIMEOUT_MS=300
# Tool deadline across attempts. 0 disables it. The fault cohort uses 1500.
# VOICE_CASCADE_TOOL_DEADLINE_MS=0
# v1 signatures stay accepted while this is 1 (0.2.0 default, deprecated, D5 open).
# VOICE_CASCADE_ACCEPT_V1_SIGNATURE=1
# Second HMAC secret id during rotation. Empty unless you are rotating. Not a real secret here.
# VOICE_CASCADE_HMAC_PREVIOUS_SECRET=
# VOICE_CASCADE_SIGNATURE_TOLERANCE_S=300
# Debug flag. Off. When 1, poison 4xx is retried and the webhook regression goes red.
# VOICE_CASCADE_RETRY_NONRETRYABLE=0
# Optional Silero marker. Off. Setting 1 still does not download weights in 0.2.1.
# VOICE_CASCADE_ENABLE_SILERO=0
VOICE_CASCADE_LOG_LEVEL=INFO
VOICE_CASCADE_DATA_DIR=./var

# Refuse-only flags. They do not send. The optional measurement command is below.
VOICE_CASCADE_ENABLE_REAL_STT=0
VOICE_CASCADE_ENABLE_REAL_LLM=0
VOICE_CASCADE_ENABLE_REAL_TTS=0
VOICE_CASCADE_STT_API_KEY=
VOICE_CASCADE_LLM_API_KEY=
VOICE_CASCADE_TTS_API_KEY=

# [EST] Simulated-clock law. Empty keeps the defaults in latency.py.
# VOICE_CASCADE_STT_MEDIAN_MS=
# VOICE_CASCADE_STT_SIGMA=
# VOICE_CASCADE_LLM_MEDIAN_MS=
# VOICE_CASCADE_LLM_SIGMA=
# VOICE_CASCADE_TTS_MEDIAN_MS=
# VOICE_CASCADE_TTS_SIGMA=
# VOICE_CASCADE_TOOL_MEDIAN_MS=
# VOICE_CASCADE_TOOL_SIGMA=
# VOICE_CASCADE_REPLAY_MEDIAN_MS=
# VOICE_CASCADE_REPLAY_SIGMA=
# VOICE_CASCADE_VAD_SIGMA=

# Optional real-provider measurement. Off unless LIVE_MODE=1. Do not set this in CI.
# Missing any required variable, or an estimate above MAX_LIVE_SPEND_USD, exits 2
# and sends no request. Put prices you read yourself, and the date you read them.
# LIVE_CHARS_PER_TOKEN defaults to 4 and is [EST].
# Speech call: POST LIVE_STT_URL with JSON {"text": "..."} and Authorization: Bearer.
# Language call: POST {LIVE_LLM_BASE_URL}/chat/completions with Authorization: Bearer.
# Synthesis call: POST {LIVE_TTS_BASE_URL}/v1/text-to-speech/{LIVE_TTS_VOICE_ID}
# with header xi-api-key. No appointment is written.
LIVE_MODE=0
MAX_LIVE_SPEND_USD=
LIVE_PRICE_DATE=
LIVE_STT_URL=
LIVE_STT_API_KEY=
LIVE_STT_USD_PER_CALL=
LIVE_LLM_BASE_URL=
LIVE_LLM_API_KEY=
LIVE_LLM_MODEL=
LIVE_LLM_USD_PER_1K_INPUT_TOKENS=
LIVE_LLM_USD_PER_1K_OUTPUT_TOKENS=
LIVE_LLM_RESERVED_OUTPUT_TOKENS=
LIVE_TTS_BASE_URL=
LIVE_TTS_API_KEY=
LIVE_TTS_VOICE_ID=
LIVE_TTS_MODEL_ID=
LIVE_TTS_USD_PER_1K_CHARS=
# real, stub, or empty. Empty means stub on loopback (127.0.0.1, localhost) and real otherwise.
# LIVE_STT_SOURCE=
# LIVE_LLM_SOURCE=
# LIVE_TTS_SOURCE=
# Optional label stored in results.json. Do not put a key here.
# LIVE_STT_PROVIDER=
# LIVE_LLM_PROVIDER=
# LIVE_TTS_PROVIDER=
# Optional. If unset, cost.estimated_usd prices every input token at the uncached rate
# even when the response reports cached tokens. cost_basis is
# "tokens_x_price, cached tokens priced separately".
# provider_reported_usd is written only from integer usage.cost_in_usd_ticks
# (1 tick = 1e-10 USD). A token times price figure, usage.cost, or a replayed
# dollar field is not that key.
# LIVE_LLM_USD_PER_1K_CACHED_TOKENS=
